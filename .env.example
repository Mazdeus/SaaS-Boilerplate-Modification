# ===================================================================
# TEMPLATE ENVIRONMENT VARIABLES
# ===================================================================
# Copy file ini menjadi .env.local dan isi dengan nilai yang sesuai
# JANGAN commit file .env.local ke Git repository!

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================
# Neon PostgreSQL connection string
# Format: postgresql://username:password@host/database?sslmode=require
# Dapatkan dari Neon dashboard setelah membuat project
DATABASE_URL="postgresql://username:password@ep-example-123456.region.aws.neon.tech/main?sslmode=require"

# ===================================================================
# NEXTAUTH CONFIGURATION (untuk CMS Authentication)
# ===================================================================
# Secret key untuk NextAuth - gunakan random string yang kuat
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-key-here-use-random-string"
# URL aplikasi (development: http://localhost:3000, production: your-domain.com)
NEXTAUTH_URL="http://localhost:3000"

# ===================================================================
# CLERK AUTHENTICATION (sudah ada di .env)
# ===================================================================
# Clerk secret key - dapatkan dari Clerk dashboard
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# ===================================================================
# STRIPE CONFIGURATION (sudah ada di .env)
# ===================================================================
# Stripe secret key - dapatkan dari Stripe dashboard
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ===================================================================
# OPTIONAL: ADDITIONAL DATABASE CONFIGURATIONS
# ===================================================================
# Database connection pool settings (opsional)
# DATABASE_CONNECTION_LIMIT=20
# DATABASE_IDLE_TIMEOUT=30000

# Environment untuk database migrations
# NODE_ENV=development

# ===================================================================
# INSTRUCTIONS
# ===================================================================
# 1. Copy file ini: cp .env.example .env.local
# 2. Isi DATABASE_URL dengan connection string dari Neon
# 3. Isi secret keys untuk Clerk dan Stripe jika diperlukan
# 4. Jangan commit file .env.local ke Git!
# 5. Test koneksi dengan: npm run db:test
