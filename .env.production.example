# ⚠️ IMPORTANT: EDIT THIS FILE BEFORE DEPLOYMENT
# Copy this file to .env.production and fill in your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Format: postgresql://username:password@host:port/database?schema=public
# Example: postgresql://postgres:mypassword@localhost:5432/brodo_cms?schema=public
DATABASE_URL="postgresql://username:password@host:5432/database_name?schema=public"

# ============================================
# JWT AUTHENTICATION CONFIGURATION
# ============================================
# Secret key for JWT token signing (used by src/lib/auth.ts)
# Generate with: openssl rand -base64 32
# Must be at least 32 characters long
JWT_SECRET="CHANGE_THIS_TO_A_RANDOM_STRING_MIN_32_CHARS"

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=production

# Public API URL
# For Azure VM: http://40.81.26.137:3000
# For production with domain: https://yourdomain.com
NEXT_PUBLIC_API_URL="http://40.81.26.137:3000"

# ============================================
# OPTIONAL CONFIGURATIONS
# ============================================
# Uncomment and configure if needed

# Image upload service (if using external service)
# NEXT_PUBLIC_IMAGE_UPLOAD_URL=""

# Custom domain (if using)
# NEXT_PUBLIC_DOMAIN="yourdomain.com"

# Analytics (if using)
# NEXT_PUBLIC_GA_ID=""

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 1. Never commit this file to Git
# 2. Keep DATABASE_URL secure
# 3. Use strong NEXTAUTH_SECRET
# 4. Update NEXTAUTH_URL based on deployment environment
# 5. Ensure database is accessible from Azure VM
